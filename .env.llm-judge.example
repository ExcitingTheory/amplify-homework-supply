# LLM-as-a-Judge Chat Tools Testing Environment Variables
#
# Copy this file to .env.local and add your actual API keys
# cp .env.llm-judge.example .env.local

# Required for LLM judge testing
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: Specify different model (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: Verbose logging (default: false)
# TEST_VERBOSE=true

# Optional: Test specific tool only
# TEST_TOOL=create_section
