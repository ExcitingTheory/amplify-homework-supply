{
  "name": "amplify-homework-supply",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "amplify",
    "amplify/custom/websocket"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "src/theme.js"
  ],
  "scripts": {
    "build:amplify": "amplify push",
    "build:amplify:dev": "amplify push --envName dev",
    "build:amplify:prod": "amplify push --envName prod",
    "cypress:open": "cypress open",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "lint:translate": "eslint 'src/**/*.{js,jsx,ts,tsx}' 'pages/**/*.{js,jsx,ts,tsx}'",
    "lint:translate:report": "eslint 'src/*.{js,jsx,ts,tsx}' 'src/**/*.{js,jsx,ts,tsx}' 'pages/**/*.{js,jsx,ts,tsx}' -o i18n-report.txt && echo 'Translation report generated: i18n-report.txt'",
    "lint:translate:stories": "eslint '**/*.stories.{js,jsx,ts,tsx}'",
    "extract:mui-props": "node scripts/extract-mui-props.mjs",
    "post-update": "echo \"codesandbox preview only, need an update\" && yarn upgrade --latest",
    "amplify:upgrade": "npx npm-check-updates -i '/@?aws-amplify/' && npm update",
    "manage-admins": "node scripts/manage-admins.js",
    "storybook": "NODE_OPTIONS='--experimental-import-meta-resolve' storybook dev -p 6006",
    "build-storybook": "NODE_OPTIONS='--experimental-import-meta-resolve' storybook build",
    "test": "vitest",
    "test:unit": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:storybook": "NODE_OPTIONS='--experimental-import-meta-resolve' vitest --project=storybook",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "chromatic": "chromatic --project-token=",
    "storybook:inventory": "tsx scripts/generate-story-inventory.ts",
    "storybook:validate-mocks": "vitest run test/storybook/validate-mocks.test.ts",
    "storybook:validate-components": "tsx scripts/validate-component-mocks.ts",
    "storybook:test": "npm run storybook:inventory && npm run storybook:validate-mocks && npm run storybook:validate-components && npm run typecheck"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@aws-amplify/ui-react": "^6.0.7",
    "@aws-sdk/client-cognito-identity-provider": "^3.971.0",
    "@emotion/cache": "latest",
    "@emotion/react": "latest",
    "@emotion/server": "latest",
    "@emotion/styled": "latest",
    "@excalidraw/excalidraw": "^0.18.0",
    "@google/generative-ai": "^0.24.1",
    "@lexical/code": "^0.39.0",
    "@lexical/hashtag": "^0.39.0",
    "@lexical/link": "^0.39.0",
    "@lexical/list": "^0.39.0",
    "@lexical/mark": "^0.39.0",
    "@lexical/markdown": "^0.39.0",
    "@lexical/react": "^0.39.0",
    "@lexical/rich-text": "^0.39.0",
    "@lexical/table": "^0.39.0",
    "@lexical/utils": "^0.39.0",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@mui/x-data-grid": "^8.22.1",
    "@tanstack/react-virtual": "^3.13.18",
    "@vitejs/plugin-react": "^5.1.3",
    "aws-amplify": "^6.15.9",
    "graphql-request": "^7.4.0",
    "i18next": "^25.8.0",
    "i18next-resources-to-backend": "^1.2.1",
    "katex": "^0.15.3",
    "lexical": "^0.39.0",
    "lib0": "^0.2.117",
    "next": "^16.1.0",
    "next-i18next": "^15.4.3",
    "openai": "^4.104.0",
    "opentype.js": "^1.3.4",
    "pdfjs-dist": "^5.4.449",
    "prop-types": "latest",
    "rdndmb-html5-to-touch": "^8.0.1",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dnd-multi-backend": "^8.0.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.2.0",
    "ws": "^8.19.0",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.29"
