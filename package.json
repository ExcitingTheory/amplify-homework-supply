    "@mui/x-data-grid": "^8.22.1",
    "@tanstack/react-virtual": "^3.13.18",
    "@vitejs/plugin-react": "^5.1.3",
    "aws-amplify": "^6.15.9",
    "graphql-request": "^7.4.0",
    "i18next": "^25.8.0",
    "i18next-resources-to-backend": "^1.2.1",
    "idb": "^8.0.3",
    "katex": "^0.16.38",
    "lexical": "^0.39.0",
    "lib0": "^0.2.117",
    "next": "^16.1.0",
    "next-i18next": "^15.4.3",
    "openai": "^4.104.0",
    "opentype.js": "^1.3.4",
    "pako": "^2.1.0",
    "pdfjs-dist": "5.4.296",
    "prop-types": "latest",
    "rdndmb-html5-to-touch": "^8.0.1",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dnd-multi-backend": "^8.0.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
