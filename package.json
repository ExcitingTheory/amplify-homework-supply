{
  "name": "amplify-homework-supply",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "amplify",
    "amplify/custom/websocket"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "src/theme.js"
  ],
  "scripts": {
    "postinstall": "patch-package && node scripts/copy-pdf-worker.js",
    "deploy": "npx ampx deploy",
    "deploy:prod": "npx ampx deploy --branch main",
    "sandbox": "npx ampx sandbox --stream-function-logs",
    "sandbox:with-logs": "npx ampx sandbox --stream-function-logs | tee test/logs/sandbox.log",
    "sandbox:seed": "export $(cat .env.test | xargs) && npx ampx sandbox seed",
    "sandbox:delete": "npx ampx sandbox delete",
    "sandbox:secret": "npx ampx sandbox secret set TEST_USER_PASSWORD",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:workflow": "cypress run --spec 'cypress/e2e/complete-workflow.cy.ts'",
    "cypress:onboarding": "cypress run --spec 'cypress/e2e/onboarding-*.cy.ts'",
    "cypress:workbook": "cypress run --spec 'cypress/e2e/workbook-spec.cy.ts'",
    "cypress:with-logs": "CYPRESS_CONSOLE_LOGS=error,warn npm run cypress:run | tee test/logs/cypress.log",
    "crawl": "export $(cat .env.test | xargs) && node scripts/crawl-console.mjs",
    "crawl:with-logs": "export $(cat .env.test | xargs) && node scripts/crawl-console.mjs 2>&1 | tee test/results/crawl.log",
    "generate:routes": "node scripts/generate-route-list.js",
    "dev": "next dev --experimental-https",
    "dev:collab": "concurrently -n yjs,next -c blue,green \"tsx scripts/yjs-dev-server.ts\" \"NEXT_PUBLIC_YJS_WS_URL=wss://localhost:3001 next dev --experimental-https\"",
    "dev:collab:with-logs": "concurrently -n yjs,next -c blue,green \"tsx scripts/yjs-dev-server.ts 2>&1 | tee test/logs/collab.log\" \"NEXT_PUBLIC_YJS_WS_URL=wss://localhost:3001 next dev --experimental-https 2>&1 | tee test/logs/next-dev.log\"",
    "dev:yjs": "tsx scripts/yjs-dev-server.ts",
    "dev:with-logs": "next dev --experimental-https 2>&1 | tee test/logs/next-dev.log",
    "build": "next build",
    "build:checked": "npm run typecheck && next build",
    "start": "next start",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}' 'pages/**/*.{js,jsx,ts,tsx}' 'app/**/*.{ts,tsx}' 'amplify/**/*.ts' --max-warnings=0",
    "lint:fix": "eslint 'src/**/*.{js,jsx,ts,tsx}' 'pages/**/*.{js,jsx,ts,tsx}' 'app/**/*.{ts,tsx}' 'amplify/**/*.ts' --fix",
    "lint:translate": "eslint 'src/**/*.{js,jsx,ts,tsx}' 'pages/**/*.{js,jsx,ts,tsx}'",
    "lint:translate:report": "eslint 'src/*.{js,jsx,ts,tsx}' 'src/**/*.{js,jsx,ts,tsx}' 'pages/**/*.{js,jsx,ts,tsx}' -o i18n-report.txt && echo 'Translation report generated: i18n-report.txt'",
    "lint:translate:stories": "eslint '**/*.stories.{js,jsx,ts,tsx}'",
    "i18n:check": "node scripts/check-i18n.js",
    "i18n:fix": "node scripts/check-i18n.js --fix-structure",
    "extract:mui-props": "node scripts/extract-mui-props.mjs",
    "post-update": "echo \"codesandbox preview only, need an update\" && yarn upgrade --latest",
    "amplify:upgrade": "npx npm-check-updates -i '/@?aws-amplify/' && npm update",
    "manage-admins": "node scripts/manage-admins.js",
    "storybook": "NODE_OPTIONS='--experimental-import-meta-resolve' storybook dev -p 6006",
    "storybook:with-logs": "NODE_OPTIONS='--experimental-import-meta-resolve' storybook dev -p 6006 | tee test/logs/storybook.log",
    "build-storybook": "NODE_OPTIONS='--experimental-import-meta-resolve' storybook build",
    "test": "vitest",
    "test:unit": "vitest run --project=unit --exclude 'test/integration/**' --exclude 'test/performance/**'",
    "generate": "npx ampx generate graphql-client-code",
    "test:integration": "vitest run --project=integration",
    "test:performance": "vitest run --project=unit test/performance",
    "test:performance:concurrent": "vitest run --project=unit test/performance/concurrent-users.test.ts",
    "test:performance:yjs": "vitest run --project=unit test/performance/yjs-collaboration.test.ts",
    "test:performance:datastore": "vitest run --project=unit test/performance/datastore-sync.test.ts",
    "test:watch": "vitest watch --project=unit",
    "test:coverage": "vitest run --project=unit --coverage",
    "test:storybook": "NODE_OPTIONS='--experimental-import-meta-resolve' vitest --project=storybook",
    "agent-cli": "tsx scripts/agent-cli.ts",
    "agent:check": "tsx scripts/agent-cli.ts check",
    "agent:execute": "tsx scripts/agent-cli.ts execute",
    "agent:logs": "tsx scripts/agent-cli.ts logs",
    "agent:safe-mode": "tsx scripts/agent-cli.ts safe-mode",
    "typecheck": "tsc --noEmit --project config/tsconfig.build-src.json && tsc --noEmit --project config/tsconfig.build-gamification.json && tsc --noEmit --project config/tsconfig.build-pages.json",
    "typecheck:parallel": "concurrently -n src,gamification,pages \"tsc --noEmit --project config/tsconfig.build-src.json\" \"tsc --noEmit --project config/tsconfig.build-gamification.json\" \"tsc --noEmit --project config/tsconfig.build-pages.json\"",
    "chromatic": "chromatic --project-token=",
    "storybook:run": "NODE_OPTIONS='--experimental-import-meta-resolve' npx vitest --project=storybook --run",
    "storybook:run:with-logs": "NODE_OPTIONS='--experimental-import-meta-resolve' npx vitest --project=storybook --run 2>&1 | tee test/logs/storybook-run.log",
    "storybook:clear": "rm -rf node_modules/.cache/storybook && rm -rf node_modules/.vite && echo \"Caches cleared\"",
    "storybook:report": "npm run test:storybook -- --run --reporter=verbose --reporter=json --outputFile=test/results/storybook.json",
    "storybook:inventory": "tsx scripts/generate-story-inventory.ts",
    "storybook:validate-mocks": "vitest run test/storybook/validate-mocks.test.ts",
    "storybook:validate-components": "tsx .github/skills/storybook-validation/scripts/validate-component-mocks.ts",
    "storybook:test": "npm run storybook:inventory && npm run storybook:validate-mocks && npm run storybook:validate-components && npm run typecheck",
    "clean:logs": "rm -rf test/logs/*.log && echo \"Logs cleaned\"",
    "clean:results": "rm -rf test/results/*.log test/results/*.json test/results/*.txt && echo \"Results cleaned\"",
    "clean": "npm run clean:logs && npm run clean:results && rm -rf .next storybook-static node_modules/.cache/storybook node_modules/.vite && echo \"All caches cleaned\""
  },
